# ─── Tailscale Node Addresses ────────────────────────────────────────────────
# When running with Tailscale, replace these with your MagicDNS hostnames.
# Format: <machine-name>.<tailnet-name>.ts.net
# Example: ingestion-node.tail1ab2c.ts.net
#
# When running locally (without Tailscale), use localhost + different ports.

INGESTION_HOST=localhost
INGESTION_PORT=8001

NLP_HOST=localhost
NLP_PORT=8002

STORAGE_HOST=localhost
STORAGE_PORT=8003

DASHBOARD_HOST=localhost
DASHBOARD_PORT=8000

# ─── Tailscale (production deployment) ───────────────────────────────────────
# Obtain from: https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxxxxxxxxxx

# ─── Optional: NewsAPI key for richer news data ───────────────────────────────
# Free tier at https://newsapi.org/  (leave blank to use free RSS feeds)
NEWS_API_KEY=
